<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.TeletravailDashboardController"
      stylesheets="@style.css" styleClass="content-area">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <VBox spacing="6">
        <Label text="Dashboard Télétravail" styleClass="title-label"/>
        <Label text="Vue globale des demandes TT, validations et suivi mensuel" styleClass="welcome-subtitle"/>
    </VBox>

    <HBox spacing="16">
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
            <Label text="Total TT" styleClass="kpi-label"/>
            <Label fx:id="lblTtTotal" text="0" styleClass="kpi-number"/>
        </VBox>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
            <Label text="En attente" styleClass="kpi-label"/>
            <Label fx:id="lblTtPending" text="0" styleClass="kpi-number"/>
        </VBox>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
            <Label text="Approuvées" styleClass="kpi-label"/>
            <Label fx:id="lblTtApproved" text="0" styleClass="kpi-number"/>
        </VBox>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
            <Label text="Refusées" styleClass="kpi-label"/>
            <Label fx:id="lblTtRejected" text="0" styleClass="kpi-number"/>
        </VBox>
    </HBox>

    <VBox spacing="14" styleClass="welcome-panel" VBox.vgrow="ALWAYS">
        <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
        <Label text="Pilotage télétravail" styleClass="panel-title"/>
        <Label text="✔ Consultez les volumes par statut pour les demandes télétravail." styleClass="panel-item"/>
        <Label text="✔ Ouvrez Demandes télétravail pour gérer le CRUD, le mois concerné et les décisions." styleClass="panel-item"/>
    </VBox>
</VBox>
