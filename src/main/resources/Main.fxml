<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controllers.MainController" fx:id="rootPane" stylesheets="@Style.css" prefHeight="900" prefWidth="1400">
    <left>
        <VBox spacing="20" styleClass="sidebar">
            <padding><Insets top="28" right="20" bottom="28" left="20"/></padding>
            <VBox spacing="6" styleClass="brand-box">
                <Label text="TalentFlow" styleClass="brand-title"/>
                <Label text="Unified Management" styleClass="brand-subtitle"/>
            </VBox>
            <Label text="Navigation" styleClass="section-label"/>
            <Button text="💼 Gestion de recrutement" fx:id="btnRecruitmentFlow" styleClass="sidebar-btn"/>
            <Button text="🎓 Gestion de formation" fx:id="btnFormationFlow" styleClass="sidebar-btn"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="topbar">
            <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>
            <VBox spacing="2">
                <Label text="Welcome" styleClass="topbar-title"/>
                <Label text="Choisissez un module dans la barre latérale" styleClass="topbar-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblRole" text="Role: -" styleClass="mode-label"/>
            <Label text="Dark mode" styleClass="mode-label"/>
            <ToggleButton fx:id="toggleDarkMode" styleClass="switch-toggle"/>
        </HBox>
    </top>
    <center>
        <AnchorPane fx:id="contentArea" styleClass="content-area">
            <VBox fx:id="welcomePane" alignment="TOP_LEFT" spacing="18" AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20">
                <Label text="Bienvenue 👋" styleClass="welcome-title"/>
                <Label text="Commencez par choisir Gestion de recrutement ou Gestion de formation." styleClass="welcome-subtitle"/>
            </VBox>
        </AnchorPane>
    </center>
</BorderPane>
