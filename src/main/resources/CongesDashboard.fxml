<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.CongesDashboardController"
      stylesheets="@style.css" styleClass="content-area">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <VBox spacing="6">
        <Label text="Dashboard Congés" styleClass="title-label"/>
        <Label text="Vue globale des demandes de congés et décisions RH" styleClass="welcome-subtitle"/>
    </VBox>

    <HBox spacing="16">
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
            <Label text="Total congés" styleClass="kpi-label"/>
            <Label fx:id="lblCongeTotal" text="0" styleClass="kpi-number"/>
        </VBox>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
            <Label text="En attente" styleClass="kpi-label"/>
            <Label fx:id="lblCongePending" text="0" styleClass="kpi-number"/>
        </VBox>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
            <Label text="Approuvées" styleClass="kpi-label"/>
            <Label fx:id="lblCongeApproved" text="0" styleClass="kpi-number"/>
        </VBox>
        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
            <Label text="Refusées" styleClass="kpi-label"/>
            <Label fx:id="lblCongeRejected" text="0" styleClass="kpi-number"/>
        </VBox>
    </HBox>

    <VBox spacing="14" styleClass="welcome-panel" VBox.vgrow="ALWAYS">
        <padding><Insets top="18" right="18" bottom="18" left="18"/></padding>
        <Label text="Pilotage congés" styleClass="panel-title"/>
        <Label text="✔ Consultez les volumes par statut pour les demandes de congés." styleClass="panel-item"/>
        <Label text="✔ Ouvrez Demandes congés pour ajouter, modifier, supprimer, approuver ou refuser." styleClass="panel-item"/>
    </VBox>
</VBox>
